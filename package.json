{
	"name": "sujetstore",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun run vite dev",
		"build": "bun --bun run vite build",
		"build:static": "bun run build && bun run scripts/build-static.ts",
		"preview": "bun --bun run vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write .",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:push:content": "drizzle-kit push --config=drizzle.content.config.ts",
		"db:migrate": "bun run scripts/migrate-v3.ts",
		"db:studio": "drizzle-kit studio",
		"db:studio:content": "drizzle-kit studio --config=drizzle.content.config.ts",
		"seed": "bun run scripts/seed-education.ts",
		"docs:dev-guide": "typst compile --root . --font-path static/fonts docs/developer-guide/main.typ docs/developer-guide/SujetStore-Developer-Guide-v5.pdf",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-bun": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.4",
		"@types/katex": "^0.16.8",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.8",
		"katex": "^0.16.38",
		"marked": "^17.0.4",
		"marked-katex-extension": "^5.1.7",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sqlite3": "^5.1.7",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@fontsource/cairo": "^5.2.7",
		"@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
		"@myriaddreamin/typst-ts-web-compiler": "^0.7.0-rc2",
		"@myriaddreamin/typst.ts": "^0.7.0-rc2",
		"@tailwindcss/vite": "^4.3.5",
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.1",
		"lucide-svelte": "^0.563.0",
		"mobile-drag-drop": "^3.0.0-rc.0",
		"pdfjs-dist": "^6.5.438",
		"slugify": "^1.6.6",
		"svelte-dnd-action": "^0.9.69"
	}
}
