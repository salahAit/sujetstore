# ==========================
# منصة DzLearn - .gitignore
# ==========================

# Dependencies
node_modules/

# Build outputs
.svelte-kit/
build/
build-static/
dist/
plugins/subjects/*.js
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
!.env.example

# SQLite databases & uploads
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/uploads/
data/media
data/tmp-typst/
data/*_remote.db
/content.db
*apiKey*.csv

# Test reports
playwright-report/
test-results/

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Cache
.cache/
.turbo/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Misc
*.bak
*.tmp
*.temp

# Local debug/utility scripts
scripts/debug_*.ts
scripts/temp_*.ts
scripts/test_*.ts

# Generated Subject Data (stored in RustFS S3 + /var/lib/sujetstore-media)
static/documents/
static/generated/
static/wasm/

# Pipeline large reference PDFs (manifest JSONs stay tracked)
pipeline/references/**/*.pdf
pipeline/references/**/legacy_gen1/*.pdf
pipeline/references_physics/**/*.pdf
pipeline/references_sciences/**/*.pdf
pipeline/references_arabic/**/*.pdf

# Python caches
__pycache__/
*.py[cod]

# Rust & Native Mobile/Desktop Build Artifacts & Keystores
services/rust-media-worker/target/
clients/desktop-tauri/src-tauri/target/
clients/mobile-capacitor/android/.gradle/
clients/mobile-capacitor/android/app/build/
clients/mobile-capacitor/android/build/
clients/mobile-capacitor/android/local.properties
*.keystore
*.jks
keystore.properties

