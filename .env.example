# ============================================================
# SujetStore v4.0 — Environment Variables Example
# Copy to .env (NEVER commit .env to Git!)
# ============================================================

# Runtime / Server
NODE_ENV=development
PORT=3015
HOST=127.0.0.1
ORIGIN=http://localhost:5173

# PostgreSQL 17 (Users, Sessions, Paid Subscriptions, Billing, Gamification)
DATABASE_URL=postgres://sujetstore:CHANGE_ME@127.0.0.1:5436/sujetstore_users

# RustFS S3 Object Storage (PDFs, Official BAC Archives, SVG Diagrams)
RUSTFS_ENDPOINT=http://127.0.0.1:9010
RUSTFS_BUCKET=sujetstore-media
RUSTFS_ACCESS_KEY=sujetstore
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_REGION=us-east-1

# Local Media Mirror (fallback + Typst SVG compilation via data/media symlink)
MEDIA_ROOT=/var/lib/sujetstore-media

# Chargily Pay v2 (Optional — Algerian EDAHABIA / CIB online payments)
CHARGILY_API_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# v5.0 Opaque Signed Media & Rust Watermark/Transcript Sidecar
MEDIA_SIGNING_SECRET=CHANGE_ME_64_HEX_CHARS
STRICT_OPAQUE_MEDIA=1
RUST_WORKER_URL=http://127.0.0.1:9020
RUST_WORKER_SECRET=CHANGE_ME_48_HEX_CHARS
