{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": {
			"#lib/*": ["./src/lib/*"]
		},
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"incremental": true,
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"tests",
		"*"
	],
	"exclude": [
		"src/service-worker",
		"src/service-worker.ts",
		"plugins"
	]
}
