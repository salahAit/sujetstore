          ]
        },
        {
          "type": "table",
          "headerBackground": true,
          "align": "center",
          "borders": "grid",
          "headers": [
            "كراء الحافلة",
            "سعر التذكرة",
            "تخفيض التلاميذ",
            "إعانة الجمعية",
            "عدد التلاميذ"
          ],
          "cells": [
            "12000 دج",
            "400 دج",
            "50%",
            "5000 دج",
            "$50$"
