{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SujetStore Parameterized Exercise Output Instance",
  "type": "object",
  "required": [
    "templateId",
    "seed",
    "grade",
    "trimesterId",
    "difficulty",
    "domain",
    "titleAr",
    "quizQuestion",
    "sujetExercise",
    "hints",
    "solutionStepsAr",
    "finalAnswer"
  ],
  "properties": {
    "templateId": { "type": "string", "minLength": 5 },
    "seed": { "type": "integer" },
    "grade": { "type": "string", "enum": ["1ap", "2ap", "3ap", "4ap", "5ap", "1am", "2am", "3am", "4am"] },
    "trimesterId": { "type": "string", "enum": ["t1", "t2", "t3"] },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "domain": { "type": "string", "enum": ["numeric", "geometry", "measurement", "proportionality", "integration"] },
    "titleAr": { "type": "string" },
    "quizQuestion": {
      "type": "object",
      "required": ["type", "questionText", "questionData", "explanation"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcq", "true_false", "ordering", "drag_drop", "matching", "fill_blank", "short_answer", "cloze", "calculated", "matrix"]
        },
        "questionText": { "type": "string" },
        "questionTextAr": { "type": "string" },
        "imageUrl": { "type": ["string", "null"] },
        "imageCaption": { "type": ["string", "null"] },
        "questionData": { "type": "object" },
        "explanation": { "type": "string" }
      }
    },
    "sujetExercise": {
      "type": "object",
      "required": ["points", "content"],
      "properties": {
        "num": { "type": "string" },
        "customTitle": { "type": "string" },
        "points": { "type": "number", "minimum": 0.5 },
        "instruction": { "type": "string" },
        "content": { "type": "array", "minItems": 1 }
      }
    },
    "hints": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
    "solutionStepsAr": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "finalAnswer": { "type": "string" }
  }
}
