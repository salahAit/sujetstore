<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SujetStore" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_dark_bg</item>
        <item name="colorOnPrimary">@color/brand_light_bg</item>
        <item name="android:statusBarColor">@color/brand_dark_bg</item>
        <item name="android:navigationBarColor">@color/brand_dark_bg</item>
        <item name="android:windowBackground">@color/brand_dark_bg</item>
    </style>

    <style name="Theme.SujetStore.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.SujetStore</item>
    </style>
</resources>
