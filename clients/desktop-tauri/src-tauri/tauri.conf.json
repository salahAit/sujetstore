{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SujetStore",
  "version": "1.0.0",
  "identifier": "com.sujetstore.desktop",
  "build": {
    "frontendDist": "https://sujetstore.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SujetStore",
        "url": "https://sujetstore.com",
        "userAgent": "Mozilla/5.0 (compatible; SujetStoreDesktopApp/1.0.0)",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
